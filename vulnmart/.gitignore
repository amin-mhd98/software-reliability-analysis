*.db
*.sqlite3

# Environment variables / secrets
.env
.env.local

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Screenshots generated by capture_demo.py (keep the source script,
# not the throwaway output, regenerate locally instead)
shots/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
